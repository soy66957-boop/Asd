{
  "name": "vibe-coder-video",
  "version": "1.0.0",
  "description": "30-second vertical motion graphics video: How to become a vibe coder using AI",
  "main": "src/index.ts",
  "scripts": {
    "build": "remotion build",
    "dev": "remotion studio",
    "render": "remotion render VibeCoderVideo out/video.mp4 --concurrency=4 --image-format=png --jpeg-quality=100",
    "render:60fps": "remotion render VibeCoderVideo out/video-60fps.mp4 --concurrency=4 --image-format=png --jpeg-quality=100 --frame-rate=60"
  },
  "dependencies": {
    "remotion": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/eslint-config": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
